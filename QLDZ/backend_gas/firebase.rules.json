{
  "rules": {
    ".read": "auth != null",
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'CAPTAIN'"
      }
    },
    "assets": {
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'CAPTAIN' || root.child('users').child(auth.uid).child('role').val() === 'TEAM_LEAD'"
    },
    "tasks": {
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'CAPTAIN' || root.child('users').child(auth.uid).child('role').val() === 'TEAM_LEAD'"
    },
    "inspections": {
      "$recordId": {
        ".write": "auth != null && (newData.child('trangThaiDuyet').val() === 'SUBMITTED' || root.child('users').child(auth.uid).child('role').val() === 'CAPTAIN' || root.child('users').child(auth.uid).child('role').val() === 'TEAM_LEAD')",
        "trangThaiDuyet": {
          ".validate": "newData.val() === 'SUBMITTED' || root.child('users').child(auth.uid).child('role').val() === 'CAPTAIN' || root.child('users').child(auth.uid).child('role').val() === 'TEAM_LEAD'"
        },
        "approvedBy": {
          ".validate": "!newData.exists() || root.child('users').child(auth.uid).child('role').val() === 'CAPTAIN' || root.child('users').child(auth.uid).child('role').val() === 'TEAM_LEAD'"
        }
      }
    },
    "cbm_logs": {
      "$cbmId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'VIEWER'"
      }
    },
    "defects": {
      "$defectId": {
        ".write": "auth != null && (newData.child('trangThai').val() === 'OPEN' || root.child('users').child(auth.uid).child('role').val() === 'CAPTAIN' || root.child('users').child(auth.uid).child('role').val() === 'TEAM_LEAD')"
      }
    }
  }
}
